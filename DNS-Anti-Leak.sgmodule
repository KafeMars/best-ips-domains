#!name=高级 DNS 防泄露与分流优化模块
#!desc=采用全链路 DoH 加密防劫持，底层全量接管 53 端口，静态引导防冷启动死锁，强制代理自建节点以隐藏 SNI。
#!author=Security Optimization

[General]
dns-server = https://dns.alidns.com/dns-query, https://doh.pub/dns-query, https://223.5.5.5/dns-query, https://1.12.12.12/dns-query
fallback-dns-server = https://doh.dogdns.xyz/google, https://doh.dogdns.xyz/cloudflare, https://doh.com.kg/cloudflare, https://doh.com.kg/google
ipv6 = false
hijack-dns = *:53

[Host]
dns.alidns.com = 223.5.5.5, 223.6.6.6
doh.pub = 1.12.12.12, 120.53.53.53

[Rule]
DOMAIN-SUFFIX, dogdns.xyz, PROXY
DOMAIN-SUFFIX, doh.com.kg, PROXY
DOMAIN-KEYWORD, dnsleak, PROXY
DOMAIN-SUFFIX, dnsleaktest.com, PROXY
DOMAIN-SUFFIX, bash.ws, PROXY
DOMAIN-SUFFIX, ipleak.net, PROXY
DOMAIN-SUFFIX, airvpn.org, PROXY
DOMAIN-SUFFIX, browserleaks.com, PROXY
DOMAIN-SUFFIX, browserleaks.org, PROXY
DOMAIN-SUFFIX, pixelscan.net, PROXY
DOMAIN-SUFFIX, whoer.net, PROXY
DOMAIN-SUFFIX, localdns.com, REJECT
